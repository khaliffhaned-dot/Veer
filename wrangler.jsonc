{
  // Veer: Malaysian media intelligence on Cloudflare Workers + D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veer",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-15",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API requests always hit the Worker; everything else is static SPA.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veer",
      // Replace with the id from `wrangler d1 create veer` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Feed capture + alert evaluation every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Realtime: one Durable Object per workspace (SQLite-backed class; works on the free plan).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "WorkspaceHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceHub"] }],
  // Workers AI. Model ids are overridable below; check the catalogue and your plan's availability.
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOW_SIGNUP": "false",
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_EMBED_MODEL": "@cf/baai/bge-m3",
    "AI_MERGE_THRESHOLD": "0.82"
  },
  "observability": { "enabled": true }
}
