{
  "name": "veer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Malaysian media intelligence and workflow platform on Cloudflare (Workers + D1).",
  "scripts": {
    "dev": "npm run build:web && wrangler dev --config wrangler.local.jsonc",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate:local": "node scripts/local-config.mjs && wrangler d1 migrations apply veer --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply veer --remote",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build:web && wrangler deploy",
    "predev": "node scripts/local-config.mjs",
    "dev:ai": "npm run build:web && wrangler dev"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^4.168.0"
  }
}
